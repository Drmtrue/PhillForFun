rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{id} {
      // Рейтинг видят все
      allow read: if true;

      // Добавить результат может любой, но только в правильном формате
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'total', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.total <= 10
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= request.resource.data.total
        && request.resource.data.createdAt == request.time;

      // Менять и удалять чужие результаты нельзя
      allow update, delete: if false;
    }
  }
}
